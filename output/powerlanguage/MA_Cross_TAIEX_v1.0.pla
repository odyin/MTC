{// ============================================================
// Strategy: MA_Cross_TAIEX
// Version:  1.0
// Description: 雙均線交叉策略 - 快線上穿慢線做多，快線下穿慢線做空
// Generated by MTC (MultiCharts Trading Code Generator)
// ============================================================}

[IntrabarOrderGeneration = true]

Inputs:
    fast_ma_period(10),
    slow_ma_period(30),
    StopLossPoints(100),
    TakeProfitPoints(200),
    MaxDailyLoss(300);

Variables:
    fast_ma(0),
    slow_ma(0),
    intrabarpersalivedone(false);

fast_ma = Average(Close, fast_ma_period);

slow_ma = Average(Close, slow_ma_period);


// ============================================================
// Entry Rules
// ============================================================
// Long Entry
If fast_ma crosses above slow_ma Then
    Buy ("MA_Cross_TAIEX_L") next bar at market;

// Short Entry
If fast_ma crosses below slow_ma Then
    SellShort ("MA_Cross_TAIEX_S") next bar at market;

// ============================================================
// Exit Rules
// ============================================================
SetStopLoss(StopLossPoints * BigPointValue);
SetProfitTarget(TakeProfitPoints * BigPointValue);

// Time Exit - close before session end
If Time >= 1330 Then Begin
    If MarketPosition = 1 Then
        Sell ("MA_Cross_TAIEX_TimeL") next bar at market;
    If MarketPosition = -1 Then
        BuyToCover ("MA_Cross_TAIEX_TimeS") next bar at market;
End;

// ============================================================
// Risk Management
// ============================================================
// Max Daily Loss Protection
If OpenPositionProfit <= -MaxDailyLoss * BigPointValue Then Begin
    If MarketPosition = 1 Then
        Sell ("MA_Cross_TAIEX_MDL_L") next bar at market;
    If MarketPosition = -1 Then
        BuyToCover ("MA_Cross_TAIEX_MDL_S") next bar at market;
End;